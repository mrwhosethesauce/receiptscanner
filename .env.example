# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/receiptscanner

# Secret used to sign JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key (https://aistudio.google.com/apikey) — free tier
GEMINI_API_KEY=AIza...

# Vercel Blob read/write token (from your Vercel project's Storage tab)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
